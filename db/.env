# Copia este archivo como .env y pon tus valores reales.
#   copy .env.example .env      (Windows CMD)
#
# .env NO se sube a git. .env.example SÍ, para que el resto del semillero sepa
# qué variables hay que definir. Esa es toda la diferencia entre los dos.

# --- PostgreSQL (el contenedor) ----------------------------------------------
# Estos tres los lee docker-compose.yml para crear la base, y también los lee
# ingesta.py para conectarse. Una sola fuente de verdad.
POSTGRES_USER=audios_admin
POSTGRES_PASSWORD=CABALAS
POSTGRES_DB=audios

# Cómo se conecta ingesta.py desde Windows al contenedor.
# 5433, no 5432: el 5432 lo tiene el PostgreSQL nativo instalado en Windows.
PGHOST=localhost
PGPORT=5433

# --- Carpeta del proyecto ----------------------------------------------------
# Ruta LOCAL a la carpeta AudiosSemilleroCABALAS, ya sincronizada desde OneDrive
# a este equipo. Tiene que ser una carpeta que se vea en el Explorador de
# Windows: el script lee archivos, no páginas web.
#
# Apunta a AudiosSemilleroCABALAS, NO a "Estación 1". El script usa el nombre de
# la subcarpeta para saber de qué estación es cada archivo, así que la Estación 2
# entrará sola cuando exista.
#
# Cada persona del semillero pone aquí SU ruta; por eso .env no va a git.
CARPETA_PROYECTO=/home/tensem/Documents/AudiosSemilleroCABALAS

# Nombre lógico del almacenamiento. Tiene que coincidir con la columna `origen`
# de la tabla `almacenamiento` (ver sql/02_semillas.sql). NO es una ruta ni una
# URL: la dirección real de SharePoint vive en esa tabla, en una sola fila.
ORIGEN=onedrive-cabalas

ONEDRIVE_URL_PREFIX=https://academiausbbogedu-my.sharepoint.com/:f:/g/personal/agomeza2_academia_usbbog_edu_co/IgCf8sR3b8_pSLCfDiFhsR32AQNB71g-QUrcXaXLpXwe91g?e=iRktyS
